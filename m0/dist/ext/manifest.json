{
  "manifest_version": 3,
  "name": "SolLedger 数据助手（M0 验证）",
  "version": "0.2.0",
  "description": "在三角洲行动官方页面里查你自己的烽火地带数据，只导出数据结构，不读取登录凭据。非官方工具。",
  "minimum_chrome_version": "110",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.wegame.com.cn/helper/df/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SolLedger 数据助手"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8766/receiver.html*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
